<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_hoa_don_ban_tree" model="ir.ui.view">
            <field name="name">hoa.don.ban.tree</field>
            <field name="model">hoa_don_ban</field>
            <field name="arch" type="xml">
                <tree string="Hóa đơn bán hàng" decoration-success="trang_thai=='da_thanh_toan'" 
                      decoration-info="trang_thai=='da_xuat'" decoration-muted="trang_thai=='nhap'">
                    <field name="ma_hoa_don"/>
                    <field name="ngay_hoa_don"/>
                    <field name="ten_khach_hang"/>
                    <field name="tong_tien_hang" sum="Tổng tiền hàng"/>
                    <field name="tien_vat" sum="Tổng VAT"/>
                    <field name="tong_thanh_toan" sum="Tổng thanh toán"/>
                    <field name="hinh_thuc_thanh_toan"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_hoa_don_ban_form" model="ir.ui.view">
            <field name="name">hoa.don.ban.form</field>
            <field name="model">hoa_don_ban</field>
            <field name="arch" type="xml">
                <form string="Hóa đơn bán hàng">
                    <header>
                        <button name="action_xuat_hoa_don" string="Xuất hóa đơn" 
                                type="object" attrs="{'invisible': [('trang_thai', '!=', 'nhap')]}" 
                                class="oe_highlight"/>
                        <field name="trang_thai" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="ma_hoa_don" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Thông tin khách hàng">
                                <field name="ngay_hoa_don"/>
                                <field name="ten_khach_hang"/>
                                <field name="ma_so_thue"/>
                                <field name="dia_chi"/>
                                <field name="dien_thoai"/>
                            </group>
                            <group string="Thanh toán">
                                <field name="hinh_thuc_thanh_toan"/>
                                <field name="phuong_thuc_vat"/>
                                <field name="nguoi_lap_id"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Chi tiết hóa đơn">
                                <field name="chi_tiet_ids">
                                    <tree editable="bottom">
                                        <field name="ten_hang_hoa"/>
                                        <field name="don_vi_tinh"/>
                                        <field name="so_luong"/>
                                        <field name="don_gia"/>
                                        <field name="thanh_tien" sum="Tổng"/>
                                        <field name="ghi_chu"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="tong_tien_hang" widget="monetary"/>
                                    <field name="ty_le_vat" invisible="1"/>
                                    <field name="tien_vat" widget="monetary"/>
                                    <field name="tong_thanh_toan" class="oe_subtotal_footer_separator" widget="monetary"/>
                                </group>
                            </page>
                            <page string="Ghi chú">
                                <field name="ghi_chu" nolabel="1"/>
                            </page>
                            <page string="Kế toán" attrs="{'invisible': [('but_toan_id', '=', False)]}">
                                <group>
                                    <field name="but_toan_id" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_hoa_don_ban" model="ir.actions.act_window">
            <field name="name">Hóa đơn bán</field>
            <field name="res_model">hoa_don_ban</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo hóa đơn bán hàng
                </p>
            </field>
        </record>

    </data>
</odoo>
