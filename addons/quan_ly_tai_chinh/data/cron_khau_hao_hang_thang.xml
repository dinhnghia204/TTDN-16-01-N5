<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job tự động tạo bút toán khấu hao hàng tháng -->
        <record id="cron_khau_hao_hang_thang" model="ir.cron">
            <field name="name">Khấu hao tài sản hàng tháng</field>
            <field name="model_id" ref="model_lich_su_khau_hao"/>
            <field name="state">code</field>
            <field name="code">model._cron_tao_but_toan_khau_hao_hang_thang()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
