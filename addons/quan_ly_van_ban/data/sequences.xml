<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence cho văn bản đi -->
        <record id="seq_van_ban_di" model="ir.sequence">
            <field name="name">Số ký hiệu văn bản đi</field>
            <field name="code">van_ban_di</field>
            <field name="prefix">VBĐ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence cho văn bản đến -->
        <record id="seq_van_ban_den" model="ir.sequence">
            <field name="name">Số ký hiệu văn bản đến</field>
            <field name="code">van_ban_den.sequence</field>
            <field name="prefix">VBĐến/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence cho loại văn bản -->
        <record id="seq_loai_van_ban" model="ir.sequence">
            <field name="name">Mã loại văn bản</field>
            <field name="code">loai_van_ban.sequence</field>
            <field name="prefix">LVB</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
